#!/bin/sh
# A stand-in for Claude Code's `claude` command, for tests and headless scenes. It speaks the
# parts of the real protocol the app uses and needs no account or network.
#
# FAKE_CLAUDE_HOME is a scratch directory. Its `state` file holds one of:
#   signed-out  `auth status` reports no sign-in
#   signed-in   signed in with a Claude Max subscription
#   expired     `auth status` reports a sign-in, but every message is rejected for it
#   console     signed in with an API key, not a subscription
#   broken      `auth status` fails
# `auth login` waits until a `browser-done` file appears there (the captain approving in the
# browser), then signs in. FAKE_CLAUDE_LOGIN=fail makes it fail instead. A message containing
# "fail" gets an error result.
#
# In a chat session it calls back into the app the way the real `claude` does, with curl: a
# message "note: TEXT" calls the `app_note` tool of the MCP server in --mcp-config, and a message
# "run: COMMAND" asks the PreToolUse hook in --settings whether Bash may run COMMAND, then says
# what the hook decided. "write: PATH CONTENT" asks the same about the Write tool, "read: PATH"
# about the Read tool, "big:" asks
# about a Bash command far larger than the app will show, and "abandon: COMMAND" asks about
# COMMAND but hangs up after a second, as Claude Code does when it stops waiting.
#
# A message "show: PATH" uses the Read tool on PATH, the way the real `claude` reports it: a
# tool_use record, then a tool_result with the image as a base64 block for a .png, or a line of
# text for anything else. "shell: COMMAND" uses Bash, whose result is three lines of text.
#
# Each message first goes to the UserPromptSubmit hook, as the real `claude` sends it. A message
# "context?" is answered with whether that hook added the app's instruction about views.
#
# A message "list: A, B, C" is answered with a Markdown list of A, B and C, then the Stop hook is
# asked about it with the list as `last_assistant_message`. If the hook sends the reply back with
# feedback, the fake shows the list as a view with the app_ui tool (the MCP call, then the
# tool_use and tool_result records) and asks the Stop hook again, the way the real `claude`
# continues a turn, and ends with "Shown above.". "stubborn: A, B, C" ignores the feedback and
# stops again with the same list and `stop_hook_active` unset, then ends with "Left as text.", or
# with "looped" if the hook sent it back a second time.
#
# A message "remind: WHEN | TEXT" calls the `app_remind` tool with TEXT and WHEN, where WHEN is
# "in AMOUNT UNIT" or one of the keywords such as tomorrow_morning, and answers with the tool's
# text. A message "reminders?" calls `app_reminders` and answers with its text.
#
# A message containing "whereami" is answered with the session's working directory and FM_HOME.
# After a message "wake: TEXT" and its reply, a second turn nobody asked for says TEXT, the way
# a firstmate Stop hook wakes an idle session.
set -eu
home=${FAKE_CLAUDE_HOME:?FAKE_CLAUDE_HOME must name a scratch directory}
state=$(cat "$home/state" 2>/dev/null || echo signed-out)

case "${1:-}" in
--version)
  echo "9.9.9 (Claude Code fake)"
  ;;
auth)
  case "${2:-}" in
  status)
    case $state in
    broken)
      echo "fake claude: the settings file is corrupt" >&2
      exit 2
      ;;
    console)
      echo '{"loggedIn":true,"authMethod":"api_key","apiProvider":"firstParty"}'
      ;;
    signed-in | expired)
      echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty","subscriptionType":"max"}'
      ;;
    *)
      echo '{"loggedIn":false,"authMethod":"none","apiProvider":"firstParty"}'
      exit 1
      ;;
    esac
    ;;
  login)
    # The real command is interactive and refuses to run without a terminal.
    if ! [ -t 0 ] || ! [ -t 1 ]; then
      echo "fake claude: auth login needs a terminal" >&2
      exit 1
    fi
    printf '\033[2K\033[1GOpening browser to sign in\342\200\246\r\n'
    printf "Browser didn't open? Use the url below to sign in\r\n\r\n"
    printf '\033[36mhttps://claude.ai/oauth/authorize?code=true&client_id=fake-client&state=fake-state\033[39m\r\n\r\n'
    printf 'Paste code here if prompted > '
    if [ "${FAKE_CLAUDE_LOGIN:-}" = fail ]; then
      sleep 0.2
      printf '\r\nOAuth error: the fake sign-in was refused\r\n'
      exit 1
    fi
    tries=0
    until [ -e "$home/browser-done" ]; do
      tries=$((tries + 1))
      [ "$tries" -le 600 ] || exit 1
      sleep 0.1
    done
    echo signed-in >"$home/state"
    printf '\r\nLogin successful.\r\n'
    ;;
  *)
    echo "fake claude: unknown auth command" >&2
    exit 1
    ;;
  esac
  ;;
-p)
  # The app passes compact JSON; these pull out the one server and the one hook it names.
  mcp_url='' hook_url='' hook_base='' mcp_auth='' hook_auth=''
  while [ $# -gt 0 ]; do
    case $1 in
    --mcp-config)
      mcp_url=$(printf '%s' "$2" | sed -E 's/.*"url":"([^"]*)".*/\1/')
      mcp_auth=$(printf '%s' "$2" | sed -E 's/.*"Authorization":"([^"]*)".*/\1/')
      shift
      ;;
    --settings)
      hook_base=$(printf '%s' "$2" | sed -E 's#.*"url":"(http://[^/"]*)/hooks/.*#\1#')
      hook_url=$hook_base/hooks/pre-tool-use
      hook_auth=$(printf '%s' "$2" | sed -E 's/.*"Authorization":"([^"]*)".*/\1/')
      shift
      ;;
    esac
    shift
  done
  # POSTs JSON to the app: post URL AUTH BODY. Prints the response body.
  post() {
    curl -sf --max-time "${4:-600}" -H 'Content-Type: application/json' -H "Authorization: $2" \
      --data "$3" "$1"
  }
  # Asks the Stop hook about REPLY (JSON-escaped): stop REPLY ACTIVE. Prints the response body.
  stop() {
    post "$hook_base/hooks/stop" "$hook_auth" "{\"hook_event_name\":\"Stop\",\"stop_hook_active\":$2,\"last_assistant_message\":\"$1\"}" 30
  }
  echo $$ >"$home/pid"
  # stream-json in and out: one user record per line, one turn per record.
  while IFS= read -r line; do
    text=$(printf '%s' "$line" | sed -E 's/.*"content":"(([^"\\]|\\.)*)".*/\1/')
    context=$(post "$hook_base/hooks/user-prompt-submit" "$hook_auth" "{\"hook_event_name\":\"UserPromptSubmit\",\"prompt\":\"\"}" 30 || true)
    case $text in
    'context?')
      case $context in
      *app_ui*) text="context: the app asked for views" ;;
      *) text="context: none" ;;
      esac
      ;;
    *envcheck*) text="api-key:${ANTHROPIC_API_KEY:+reached} token:${ANTHROPIC_AUTH_TOKEN:+reached}" ;;
    *whereami*) text="cwd=$(pwd -P) FM_HOME=${FM_HOME:-unset}" ;;
    stuck:*)
      # A turn that never finishes, and ignores its hooks and input, until it is signalled.
      i=0
      while [ $i -lt 600 ]; do sleep 1; i=$((i + 1)); done
      ;;
    note:*)
      note=${text#note: }
      post "$mcp_url" "$mcp_auth" '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"fake-claude","version":"9.9.9"}}}' >/dev/null
      if post "$mcp_url" "$mcp_auth" "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"app_note\",\"arguments\":{\"text\":\"$note\"}}}" | grep -q '"content"'; then
        text="I noted it for you: $note"
      else
        text="the app_note tool did not answer"
      fi
      ;;
    remind:* | 'reminders?')
      case $text in
      remind:*)
        spec=${text#remind: }
        what=${spec#* | }
        # shellcheck disable=SC2086 # WHEN splits into its words on purpose.
        set -- ${spec%% | *}
        case $1 in
        in) arguments="{\"text\":\"$what\",\"when\":\"in\",\"amount\":$2,\"unit\":\"$3\"}" ;;
        *) arguments="{\"text\":\"$what\",\"when\":\"$1\"}" ;;
        esac
        call="{\"name\":\"app_remind\",\"arguments\":$arguments}"
        ;;
      *) call='{"name":"app_reminders","arguments":{}}' ;;
      esac
      answer=$(post "$mcp_url" "$mcp_auth" "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"tools/call\",\"params\":$call}" |
        sed -E 's/.*"text":"(([^"\\]|\\.)*)".*/\1/')
      echo '{"type":"system","subtype":"init","apiKeySource":"none","model":"fake"}'
      # printf, not echo: the answer's \n escapes must reach the app as written.
      printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"$answer\"}"
      continue
      ;;
    run:* | abandon:* | big:* | write:* | read:*)
      case $text in
      run:*) tool=Bash what=${text#run: } patience=600 input="{\"command\":\"${text#run: }\"}" ;;
      abandon:*) tool=Bash what=${text#abandon: } patience=1 input="{\"command\":\"${text#abandon: }\"}" ;;
      read:*) tool=Read what=${text#read: } patience=600 input="{\"file_path\":\"${text#read: }\"}" ;;
      big:*) tool=Bash what=big patience=600 input="{\"command\":\"$(head -c 70000 /dev/zero | tr '\0' x)\"}" ;;
      write:*)
        rest=${text#write: }
        tool=Write what=${rest%% *} patience=600 input="{\"file_path\":\"${rest%% *}\",\"content\":\"${rest#* }\"}"
        ;;
      esac
      if decision=$(post "$hook_url" "$hook_auth" "{\"hook_event_name\":\"PreToolUse\",\"tool_name\":\"$tool\",\"tool_input\":$input,\"tool_use_id\":\"toolu_fake\"}" "$patience"); then
        case $decision in
        *'"permissionDecision":"allow"'*) text="$tool was allowed to run $what" ;;
        *'too large to review'*) text="$tool was denied: too large to review" ;;
        *) text="$tool was denied: $what" ;;
        esac
      else
        text="the hook did not answer, so $tool was blocked"
      fi
      ;;
    esac
    echo '{"type":"system","subtype":"init","apiKeySource":"none","model":"fake"}'
    if [ "$state" = expired ]; then
      echo '{"type":"assistant","error":"authentication_failed","message":{"role":"assistant","content":[{"type":"text","text":"OAuth token has expired."}]}}'
      echo '{"type":"result","subtype":"success","is_error":true,"result":"OAuth token has expired.","api_error_status":401}'
      continue
    fi
    case $text in
    list:* | stubborn:*)
      # The reply as Markdown, and as JSON with its line breaks escaped.
      items=${text#*: }
      reply=$(printf '%s' "$items" | sed -E 's/, */\\n- /g')
      reply="Open items:\\n- $reply"
      echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
      # printf, not echo: the reply's \n escapes must reach the app as written.
      printf '%s\n' "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"$reply\"}}}"
      final=$reply
      if stop "$reply" false | grep -q additionalContext; then
        case $text in
        list:*)
          spec="{\"root\":\"card\",\"elements\":{\"card\":{\"type\":\"Card\",\"props\":{\"title\":\"Open items\"},\"children\":[\"table\",\"go\"]},\"table\":{\"type\":\"Table\",\"props\":{\"columns\":[\"Item\"],\"rows\":[[\"$(printf '%s' "$items" | sed -E 's/, */\"],[\"/g')\"]]},\"children\":[]},\"go\":{\"type\":\"Button\",\"props\":{\"label\":\"Start on the first\"},\"on\":{\"press\":{\"action\":\"submit\",\"params\":{\"start\":\"first\"}}},\"children\":[]}}}"
          post "$mcp_url" "$mcp_auth" "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"app_ui\",\"arguments\":$spec}}" >/dev/null
          echo "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_fake_view\",\"name\":\"mcp__velvet-hammer__app_ui\",\"input\":$spec}]},\"parent_tool_use_id\":null}"
          echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_fake_view","content":"The view is shown."}]},"parent_tool_use_id":null}'
          final="Shown above."
          echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
          echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Shown above."}}}'
          stop "$final" true >/dev/null
          ;;
        stubborn:*)
          final="Left as text."
          if stop "$reply" false | grep -q additionalContext; then
            final="looped"
          fi
          echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
          echo "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"$final\"}}}"
          ;;
        esac
      fi
      printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"$final\"}"
      continue
      ;;
    show:* | shell:*)
      case $text in
      show:*)
        tool=Read path=${text#show: } input="{\"file_path\":\"${text#show: }\"}"
        case $path in
        *.png) result="[{\"type\":\"image\",\"source\":{\"type\":\"base64\",\"media_type\":\"image/png\",\"data\":\"$(base64 <"$path" | tr -d '\n')\"}}]" ;;
        *) result="\"$path is a binary file\"" ;;
        esac
        ;;
      shell:*) tool=Bash input="{\"command\":\"${text#shell: }\"}" result='"one\ntwo\nthree"' ;;
      esac
      echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
      echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Let me **look**."}}}'
      echo "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_fake_$tool\",\"name\":\"$tool\",\"input\":$input}]},\"parent_tool_use_id\":null}"
      # printf, not echo: the result's \n escapes must reach the app as written.
      printf '%s\n' "{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"tool_use_id\":\"toolu_fake_$tool\",\"content\":$result}]},\"parent_tool_use_id\":null}"
      echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
      echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"That is *all* of it."}}}'
      echo '{"type":"result","subtype":"success","is_error":false,"result":"That is *all* of it."}'
      continue
      ;;
    *fail*)
      echo '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":["fake claude: the model could not finish this turn"]}'
      continue
      ;;
    esac
    echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
    echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"You said: "}}}'
    echo "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"$text\"}}}"
    echo "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"You said: $text\"}]}}"
    echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"You said: $text\"}"
    case $text in
    wake:*)
      sleep 0.3
      echo '{"type":"stream_event","event":{"type":"message_start","message":{"role":"assistant","content":[]}}}'
      echo "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"${text#wake: }\"}}}"
      echo "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"${text#wake: }\"}"
      ;;
    esac
  done
  ;;
*)
  echo "fake claude: unsupported arguments: $*" >&2
  exit 1
  ;;
esac
